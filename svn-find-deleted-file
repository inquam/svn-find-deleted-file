#!/bin/bash

# Function to check if a file matches the gitignore-style pattern
match_pattern() {
    local file="$1"
    local pattern="$2"
    
    # Convert .gitignore style pattern to bash pattern
    # Handle common .gitignore syntax:
    # - * matches anything except /
    # - ** matches anything including /
    # - ? matches single character
    # - [abc] matches character class
    # - leading ! means negate the pattern (not implemented for simplicity)
    
    # Escape special characters except those used in patterns
    pattern=$(echo "$pattern" | sed 's/[.^$]/\\&/g')
    
    # Replace ** with a special marker
    pattern=$(echo "$pattern" | sed 's/\*\*/DOUBLESPLATMARKER/g')
    
    # Replace * with [^/]* (anything except /)
    pattern=$(echo "$pattern" | sed 's/\*/[^\/]*/g')
    
    # Replace back ** (represented by marker) with .* (anything including /)
    pattern=$(echo "$pattern" | sed 's/DOUBLESPLATMARKER/.*/g')
    
    # Add anchors for full string match
    pattern="^$pattern$"
    
    [[ "$file" =~ $pattern ]]
    return $?
}

# Get revision to start searching from
if [ -n "$1" ]; then
    rev=$1
else
    echo -n "Enter revision to start searching from: "
    read rev
fi

# Get file pattern to search for (.gitignore style)
if [ -n "$2" ]; then
    filePattern="$2"
else
    echo -n "Enter file pattern to search for (.gitignore style, empty for all files): "
    read filePattern
fi

# Loop backwards through revisions
for ((i=rev; i>0; i--)); do
    output=$(svn log -qv -r$i)
    
    # Process each line of the output
    while IFS= read -r line; do
        # Extract revision
        if [[ "${line:0:1}" == "r" ]]; then
            revision=$(echo "$line" | cut -d"|" -f1 | tr -d ' ')
            echo "Checking rev. $revision"
        # If file is deleted
        elif [[ "$(echo "$line" | awk '{print $1}')" == "D" ]]; then
            fileName=$(echo "$line" | sed 's/^D //')
            
            if [[ -z "$filePattern" || $(match_pattern "$fileName" "$filePattern") -eq 0 ]]; then
                echo "$fileName deleted in revision: $revision"
                
                if [[ -z "$filePattern" ]]; then
                    echo "$fileName deleted in revision: $revision" >> foundDeletedFiles.txt
                else
                    echo "Done!"
                    exit 0
                fi
            fi
        fi
    done <<< "$output"
done

echo "Done!"
exit 0
